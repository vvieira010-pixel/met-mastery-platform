    {"id": "dka_skill", "label": "Dispositional Knowledge Assessment Designer", "file_type": "document", "source_file": "src/education-skills/skills/original-frameworks/dispositional-knowledge-assessment-designer/SKILL.md", "source_location": "line 89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dispositional knowledge exists only in enactment; rubrics rate a fixed trait and can undermine motivation via evaluative feedback. Assessment must make the disposition VISIBLE through multi-informant evidence (teacher observation, student self-reflection, optional parent input) over time, not measure it via summative judgment."},
    {"id": "lta_skill", "label": "Learning Target Authoring Guide", "file_type": "document", "source_file": "src/education-skills/skills/original-frameworks/learning-target-authoring-guide/SKILL.md", "source_location": "line 82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory Knowledge Type classification (Type 1/2/3) determines the assessment instrument BEFORE band statements are written; this prevents the most common failure mode in competency curricula — dispositional goals assessed through rubrics (illusion of measurement)."},
    {"id": "panel_review_skill", "label": "Panel Review (Seven-Role Independent Mode)", "file_type": "document", "source_file": "src/education-skills/skills/professional-learning/panel-review/SKILL.md", "source_location": "line 68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gate rule (mean_overall>=88 AND no role mean<70) prevents a single role's sustained dissent (e.g. therapeutic-education sceptic) from being averaged into passage — the floor is a structural blocker, not a number to be averaged away."},
    {"id": "knowledge_types", "label": "Knowledge Type Classification (Type 1/2/3)", "file_type": "document", "source_file": "src/education-skills/skills/original-frameworks/learning-target-authoring-guide/SKILL.md", "source_location": "lines 115-159", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Type 3 dispositional knowledge requires multi-informant longitudinal observation (NO RUBRIC); Type 1 hierarchical -> rubric/knowledge test; Type 2 horizontal -> reasoning-quality rubric. The classification determines the assessment route."},
