      <data key="d11" />
      <data key="d12" />
      <data key="d13" />
      <data key="d14">METShell.init({totalSeconds, timerStorageKey, hasSidebar, listeningMode, hasBack, hasFinishSection, sectionLabel}) standardizes timer, progress bar, modals, and next-section navigation across every mock section.</data>
      <data key="d4">9</data>
    </node>
    <node id="mocktest3_cefr_scoring">
      <data key="d0">CEFR Band Scoring (getCEFR)</data>
      <data key="d1">code</data>
      <data key="d2">public/mock-test-2/sections/thanks.html</data>
      <data key="d3">getCEFR(total)</data>
      <data key="d10" />
      <data key="d11" />
      <data key="d12" />
      <data key="d13" />
      <data key="d14">getCEFR(total): &lt;=16 A2-, &lt;=24 B1-, &lt;=33 B1/B2, &lt;=40 B2, &lt;=46 Strong B2, else C1 - six provisional bands aligned to CEFR.</data>
      <data key="d4">9</data>
    </node>
    <node id="mocktest3_netlify_submission">
      <data key="d0">Netlify Submission + sendBeacon</data>
      <data key="d1">code</data>
      <data key="d2">public/mock-test-2/sections/thanks.html</data>
      <data key="d3">met-submission form</data>
      <data key="d10" />
      <data key="d11" />
      <data key="d12" />
      <data key="d13" />
      <data key="d14">Uses Netlify Forms (data-netlify) named met-submission plus navigator.sendBeacon('/api/save-submission'); session id via getSpeakingSessionId() / Netlify Blobs - decouples result capture from a backend DB.</data>
      <data key="d4">9</data>
    </node>
