{
  "name": "vv-method-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "eslint src/ api/ --max-warnings 0 --format compact",
    "lint:fix": "eslint src/ api/ --fix",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@grapesjs/studio-sdk": "^1.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "es-toolkit": "^1.47.1",
    "express": "^4.21.2",
    "mime": "^4.1.0",
    "motion": "^12.23.24",
    "react": "^19.2.8",
    "react-dom": "^19.0.1",
    "react-joyride": "^3.2.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.6.0",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-language-server": "^5.3.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vscode-langservers-extracted": "^4.10.0"
  }
}
