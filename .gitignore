# Dependencies
node_modules/

# Local env / secrets (never commit)
.env*
!.env.example

# Platform-specific config
.vercel/
.vercelignore
.netlify/
.npmrc

# Build output (rebuilt by Netlify CI)
dist-build/
dist/
.vite-cache-v2/

# Local tooling & logs
build-out.txt
eslint-out.txt
deno.lock
.config/

# Local runtime data (voicebox DB etc.)
/data/

# Agent scratch / superseded reports
.agents/
.workbuddy-ai/

# Transient audit / build cache artifacts
.tmp/
.tmp-build-verify/
.tmp-build-res/

# Generated graph-analysis output and Python bytecode
graphify-out/
src/graphify-out/
.graphify_*
scripts/__pycache__/

# Source material not served by the app (199 MB audio/source)
Mock Tests/

.vercel
.env*

# Local Whisper bootstrap binary (downloaded at runtime by imageio-ffmpeg, not source)
fastapi/whisper_service/bin/

# Design-review tool output (local only, regenerated per run)
.impeccable/
